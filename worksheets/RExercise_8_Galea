# Create vectors
scores <- c(78, 92, 85, 92, 67, 88, 74)
names(scores) <- c("Ana", "Ben", "Cid", "Dex", "Eli", "Fay", "Gio")

# Sort scores ascending and descending
sort_asc <- sort(scores)
sort_desc <- sort(scores, decreasing = TRUE)
sort_asc
sort_desc

# Print sorted result and check names
print(sort_asc)

# Create additional vectors
subjects <- c("Science", "Math", "English", "Filipino", "PE") 
